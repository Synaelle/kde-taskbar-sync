#!/usr/bin/env python3
"""Keep pinned apps identical on every Plasma 6 task manager (all panels, all screens).

Whichever task manager you pin/unpin/reorder on wins and is copied to the others.
At startup, if they differ, the one on the primary screen wins.
No dependencies beyond python3 and systemd's busctl.
"""
import json
import os
import subprocess
import time

CONF = os.path.expanduser("~/.config/plasma-org.kde.plasma.desktop-appletsrc")
MARK = "PINSYNC:"

JS = r"""
var LAST = %s;   // JSON text of the list everything was last synced to, or null
var FORCE = %s;
var TYPES = ["org.kde.plasma.icontasks", "org.kde.plasma.taskmanager"];

// stored value -> array of launchers (handles KConfig's "\\," list escaping)
function parse(s) {
    if (s instanceof Array) return s.map(String);
    s = String(s);
    var out = [], cur = "";
    for (var i = 0; i < s.length; i++) {
        var c = s[i];
        if (c === "\\" && i + 1 < s.length) cur += s[++i];
        else if (c === ",") { out.push(cur); cur = ""; }
        else cur += c;
    }
    out.push(cur);
    return out.filter(function (x) { return x !== ""; });
}
function sameSet(a, b) {
    return a.length === b.length && a.slice().sort().join("\n") === b.slice().sort().join("\n");
}
function setPins(w, list) {
    w.currentConfigGroup = ["General"];
    // Written twice on purpose (KDE bug 446739).
    w.writeConfig("launchers", list);
    w.writeConfig("launchers", list);
    w.reloadConfig();
}

var tms = [];
var ps = panels();
for (var i = 0; i < ps.length; i++) {
    var ws = ps[i].widgets();
    for (var j = 0; j < ws.length; j++) {
        if (TYPES.indexOf(ws[j].type) < 0) continue;
        ws[j].currentConfigGroup = ["General"];
        var list = parse(ws[j].readConfig("launchers", ""));
        tms.push({w: ws[j], screen: ps[i].screen, list: list, key: JSON.stringify(list)});
    }
}
tms.sort(function (a, b) { return a.screen - b.screen; });

var winner = null;
if (FORCE && LAST !== null) {
    // settle pass right after a sync: re-assert, don't accept echoes from Plasma
    winner = LAST;
} else if (LAST === null) {
    // startup: primary screen wins, but an empty one never wipes the rest
    for (var k = 0; k < tms.length && winner === null; k++)
        if (tms[k].list.length) winner = tms[k].key;
} else {
    // the one that changed since the last sync wins; an empty list never wins
    for (var k = 0; k < tms.length && winner === null; k++)
        if (tms[k].key !== LAST && tms[k].list.length) winner = tms[k].key;
    if (winner === null) winner = LAST;
}

var wrote = 0;
if (winner !== null) {
    var target = JSON.parse(winner);
    for (var k = 0; k < tms.length; k++) {
        if (tms[k].key === winner) continue;
        // Same apps, different order: Plasma ignores a pure reorder, so first
        // drop the last pin, then set the full list, which makes it rebuild
        // the order from scratch.
        if (sameSet(tms[k].list, target) && target.length > 1)
            setPins(tms[k].w, target.slice(0, target.length - 1));
        setPins(tms[k].w, target);
        wrote++;
    }
}
print("%s" + JSON.stringify({v: winner, count: tms.length, wrote: wrote}));
"""


def run_sync(last, force=False):
    script = JS % (json.dumps(last), json.dumps(force), MARK)
    out = subprocess.run(
        ["busctl", "--user", "--json=short", "call", "org.kde.plasmashell",
         "/PlasmaShell", "org.kde.PlasmaShell", "evaluateScript", "s", script],
        capture_output=True, text=True, timeout=20,
    )
    if out.returncode != 0:
        raise RuntimeError(out.stderr.strip() or "busctl failed")
    text = json.loads(out.stdout)["data"][0]
    for line in text.splitlines():
        if line.startswith(MARK):
            return json.loads(line[len(MARK):])
    raise RuntimeError("unexpected script output: " + text.strip())


def mtime():
    try:
        return os.stat(CONF).st_mtime_ns
    except OSError:
        return None


def main():
    last = None       # launcher string everything was last synced to
    seen = object()   # config mtime at the last sync (sentinel forces a first run)
    settle = 0        # re-assert passes left after a sync
    ticks = 0
    while True:
        now = mtime()
        # react to config changes; also re-check every 30 s as a safety net
        if now != seen or settle or ticks >= 30:
            ticks = 0
            try:
                time.sleep(0.7)  # let Plasma finish writing
                forced = settle > 0
                res = run_sync(last, forced)
                if res["v"] is not None:
                    last = res["v"]
                if forced:
                    settle -= 1
                    if res["wrote"] and settle == 0:
                        print("Plasma keeps changing the pins back after a sync; giving up until the next change", flush=True)
                elif res["wrote"]:
                    settle = 2
                    print(f"synced {res['wrote']} of {res['count']} task managers", flush=True)
                seen = now
            except (RuntimeError, subprocess.TimeoutExpired, ValueError) as e:  # plasmashell restarting, not up yet, ...
                print(f"sync failed, will retry: {e}", flush=True)
                time.sleep(5)
        ticks += 1
        time.sleep(1)


if __name__ == "__main__":
    main()
